Algoritmo sin_titulo
	Definir numero1, numero2 Como Entero
	Escribir "Ingrese el primer numero y precione enter"
	Leer numero1
	Escribir "Ingrese el segundo numero y cuando termine precione enter"
	Leer numero2
	Escribir "¿El primer nuemro es mayor?",  numero1 > numero2
	Escribir "¿El primer numero es menor?", numero1< numero2
	Escribir "¿Los numeros son iguales?", numero1 = numero2
	Escribir "¿Los numeros son diferentes?", numero1 <> numero2   
FinAlgoritmo
