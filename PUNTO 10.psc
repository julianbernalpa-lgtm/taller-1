Algoritmo sin_titulo
	Definir horastrabajadas, valorhora, salario Como Real
	Escribir "Ingrese las horas trabajas y precione enter"
	Leer horastrabajadas
	Escribir "Ingrese el valor de cada hora y precione enter y al terminar sabermos la respuesta"
	Leer valorhora
	salario <- horastrabajadas * valorhora
	Escribir  "el salario total es ", salario
FinAlgoritmo
