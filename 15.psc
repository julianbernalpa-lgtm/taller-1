Algoritmo sin_titulo
	Definir metros, centimetros, milimetros, kilometros Como Real
	Escribir "ingrese la cantidad de metros"
	Leer metros
	centimetros <- metros * 100
	milimetros <- metros * 100
	kilometros <- metros * 100
	Escribir "centimetros",centimetros
	Escribir "milimetros", milimetros
	Escribir "kilometros",kilometros
FinAlgoritmo
