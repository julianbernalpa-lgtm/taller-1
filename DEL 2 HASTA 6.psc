Algoritmo sin_titulo
	 
		Escribir " Ingresa dos cantidades a operar"
		Leer num1
		Leer num2
		Definir suma, resta, mul, division Como Real
		suma <- num1 + num2
		resta <- num1 - num2
		mul <- num1 * num2
		division <- num1 / num2
		Escribir  "La suma es : ",suma
		Escribir  "La resta es: ",resta
		Escribir  "La multiplicacion es: ",mul
		Escribir  "La division es: ",division
		
		
		
		
FinAlgoritmo
