Algoritmo sin_titulo
	Escribir "la suma de una oeracion"
	Leer num1 
	Leer num2
	Escribir sumar(num1,num2)
	Escribir restar(num1,num2)
	Escribir multiplicar(num1,num2)
	Escribir dividiendo(num1,num2)
FinAlgoritmo
Funcion suma <- sumar(num1,num2)
	suma <- num1 + num2 
	
FinFuncion
Funcion resta <- restar(num1,num2)
	resta <- num1 - num2 
FinFuncion
Funcion  multiplicacion <- multiplicar(num1,num2)
	multiplicacion <- num1 * num2
FinFuncion
Funcion dividicion <- dividiendo(num1,num2)
	dividicion <- num1 / num2
FinFuncion
	