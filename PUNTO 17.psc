Algoritmo sin_titulo
	Definir edad Como Entero
	Definir autorizacion, puedeingresar Como Logico
	Escribir "por favor pon un numero para saber la edad y a finalizar preciona enter"
	Leer edad
	Escribir "¿tiene autorizacion? (Verdadero/Falso)"
	puedeingresar <- edad >= 18 o autorizacion
	Escribir "¿puedes ingresar?", puedeingresar
FinAlgoritmo
